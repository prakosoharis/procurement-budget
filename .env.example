# Local (npm run dev) — points at the Postgres started by `docker compose up db`
DATABASE_URL=postgres://postgres:postgres@localhost:5433/it_budget

# Random secret used to sign session JWTs. Generate one with:
#   openssl rand -base64 32
JWT_SECRET=

# Groq API key (https://console.groq.com) — powers the AI Copilot chat + insights.
# Leave empty to run everything else; those two features will just show an error.
GROQ_API_KEY=
